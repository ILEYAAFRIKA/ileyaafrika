{
  "entities": {
    "users": {
      "title": "Registered Users",
      "description": "User profiles including role, contact, and settings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["guest", "host", "admin"] },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "fullName", "role"]
    },
    "listings": {
      "title": "Property Listings",
      "description": "Short-let property listings across Nigeria with physical verification details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "propertyType": { "type": "string" },
        "pricePerNight": { "type": "number" },
        "cautionFee": { "type": "number" },
        "bedrooms": { "type": "number" },
        "bathrooms": { "type": "number" },
        "maxGuests": { "type": "number" },
        "powerBackup": { "type": "string" },
        "waterSupply": { "type": "string" },
        "security": { "type": "string" },
        "state": { "type": "string" },
        "cityArea": { "type": "string" },
        "streetAddress": { "type": "string" },
        "amenities": { "type": "array", "items": { "type": "string" } },
        "photos": { "type": "array", "items": { "type": "string" } },
        "images": { "type": "array", "items": { "type": "string" } },
        "hostWhatsApp": { "type": "string" },
        "hostFullName": { "type": "string" },
        "hostEmail": { "type": "string" },
        "isPhysicallyVerified": { "type": "boolean" },
        "verificationNotes": { "type": "string" },
        "rejectionReason": { "type": "string" },
        "status": { "type": "string" },
        "isBooked": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "propertyType", "pricePerNight", "state", "cityArea", "status"]
    },
    "bookings": {
      "title": "Guest Bookings",
      "description": "Confirmed and pending reservation records for guests",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "listingId": { "type": "string" },
        "listingTitle": { "type": "string" },
        "listingPhoto": { "type": "string" },
        "propertyType": { "type": "string" },
        "state": { "type": "string" },
        "cityArea": { "type": "string" },
        "checkInDate": { "type": "string" },
        "checkOutDate": { "type": "string" },
        "numberOfNights": { "type": "number" },
        "guestsCount": { "type": "number" },
        "pricePerNight": { "type": "number" },
        "cautionFee": { "type": "number" },
        "totalAmount": { "type": "number" },
        "guestName": { "type": "string" },
        "guestEmail": { "type": "string" },
        "guestWhatsApp": { "type": "string" },
        "specialRequests": { "type": "string" },
        "bookedAt": { "type": "string" },
        "bookingReference": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["listingId", "guestEmail", "checkInDate", "checkOutDate", "totalAmount"]
    },
    "adminEmails": {
      "title": "Admin Email Whitelist",
      "description": "Authorized administrator email addresses",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "addedAt": { "type": "string" }
      },
      "required": ["email"]
    },
    "payoutSettings": {
      "title": "Host Bank Payout Settings",
      "description": "NUBAN payout preferences for hosts",
      "type": "object",
      "properties": {
        "bankName": { "type": "string" },
        "accountNumber": { "type": "string" },
        "accountName": { "type": "string" },
        "bvnVerified": { "type": "boolean" },
        "settlementFrequency": { "type": "string" },
        "hostEmail": { "type": "string" }
      },
      "required": ["bankName", "accountNumber", "accountName"]
    }
  }
}
